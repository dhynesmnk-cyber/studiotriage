# IMAP Configuration
IMAP_SERVER=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=Design Revisions
IMAP_POLL_INTERVAL=60

# Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=poolside

# Security (CHANGE THIS on first use!)
DEFAULT_PIN=0000
SECRET_KEY=change-me-in-production

# File Storage
# PROJECTS_ROOT=/Users/yourusername/Projects
